#==============================================================================================
#
#   nn/tests - Tests on the pieces: the wire format, names, broadcasting, gemm, resizing
#
#   DESCRIPTION:
#       Whole operators and models are held to onnxruntime by tests/op_check.lucb.
#
#==============================================================================================

test "varints and keys read as protobuf writes them":
    var bytes: u8[6] = [0x96, 0x01, 0x08, 0xff, 0xff, 0x03]
    var wire = Wire(data = bytes)
    assert((try wire.varint()) == 150)
    let (field, kind) = try wire.key()
    assert(field == 1 and kind == wire_varint)
    assert((try wire.varint()) == 65535)
    assert(wire.done())
    var short: u8[1] = [0x80]
    var broken = Wire(data = short)
    _ = broken.varint() catch failure:
        assert(failure.code == malformed)
        recover 0

test "names find what was inserted, through growth":
    var names: Names
    defer names.destroy()
    var labels: str[5] = ["pixel_values", "/encoder/Add_output_0", "w", "", "predicted_depth"]
    for round in 0..<(usize)30:
        for (at, label) in labels.indexed():
            try names.insert(label, (i64)(round * 5 + at))
    for (at, label) in labels.indexed():
        assert(names.find(label) == (i64)(29 * 5 + at))
    assert(names.find("absent") == none)

test "shapes broadcast as numpy's":
    var a: i64[3] = [2, 1, 4]
    var b: i64[2] = [3, 1]
    var out: i64[8]
    let rank = try broadcast(a, b, out)
    assert(rank == 3 and out[0] == 2 and out[1] == 3 and out[2] == 4)
    var steps: i64[8]
    broadcast_strides(b, 3, steps)
    assert(steps[0] == 0 and steps[1] == 1 and steps[2] == 0)
    var odd: i64[1] = [5]
    _ = broadcast(a, odd, out) catch failure:
        assert(failure.code == invalid)
        recover 0

## gemm against the plain triple loop, for an m × k times k × n product.
func check_gemm(m: usize, n: usize, k: usize) -> !:
    let left = try new f32[m * k] in memory.heap
    defer free(left) in memory.heap
    let right = try new f32[k * n] in memory.heap
    defer free(right) in memory.heap
    let result = try new f32[m * n] in memory.heap
    defer free(result) in memory.heap
    for at in 0..<left.length:
        left[at] = (f32)((at * 7) % 11) - 5.0
    for at in 0..<right.length:
        right[at] = (f32)((at * 5) % 13) - 6.0
    try gemm(left, right, result, m, n, k)
    for row in 0..<m:
        for column in 0..<n:
            var sum: f32 = 0.0
            for inner in 0..<k:
                sum += left[row * k + inner] * right[inner * n + column]
            assert(result[row * n + column] == sum)

test "gemm multiplies, on one thread and on many":
    try check_gemm(3, 5, 4)
    try check_gemm(67, 300, 129)

test "the cubic kernel is Keys' and its taps sum to one":
    assert(cubic(0.0, -0.75) == 1.0 and cubic(1.0, -0.75) == 0.0 and cubic(2.0, -0.75) == 0.0)
    let taps = try taps_for(37, 25, 25.0 / 37.0, "cubic", "half_pixel", "floor", -0.75)
    defer free(taps) in memory.heap
    for tap in taps:
        var sum: f64 = 0.0
        for at in 0..<tap.count:
            sum += (f64)tap.weights[at]
        assert(math.abs(sum - 1.0) < 1.0e-6)
